rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      // 誰でも読める（観戦・入室確認のため）
      allow read: if true;

      // ルーム作成: 作成時の不変条件を検証する
      // 注意: 本ゲームはクライアント権威設計のため、これらは「構造的な改竄」を
      //       防ぐだけで、進行中の点数・手牌の改竄は防げない（README参照）。
      allow create: if
        request.resource.data.status == 'waiting' &&
        request.resource.data.roomId  == roomId   &&
        request.resource.data.playerOrder is list  &&
        request.resource.data.playerOrder.size() == 1 &&
        request.resource.data.maxPlayers in [2, 3, 4] &&
        request.resource.data.maxRounds  in [1, 3, 5] &&
        request.resource.data.dictCheck is bool &&
        // 作成者（ホスト）のプレイヤーデータが players に存在すること
        request.resource.data.players.keys().hasOnly(request.resource.data.playerOrder);

      // ルーム更新: 存在するルームへの書き込みのみ
      allow update: if
        resource != null &&
        // プレイヤー数は最大4人まで
        (
          !('playerOrder' in request.resource.data) ||
          request.resource.data.playerOrder.size() <= 4
        ) &&
        // playerOrder は縮小禁止（参加者の勝手な除外を防ぐ）
        (
          !('playerOrder' in request.resource.data) ||
          request.resource.data.playerOrder.size() >= resource.data.playerOrder.size()
        ) &&
        // statusは決められた値のみ
        (
          !('status' in request.resource.data) ||
          request.resource.data.status in ['waiting', 'playing', 'finished']
        ) &&
        // roomId は変更不可
        (
          !('roomId' in request.resource.data) ||
          request.resource.data.roomId == resource.data.roomId
        ) &&
        // createdAt は変更不可
        (
          !('createdAt' in request.resource.data) ||
          request.resource.data.createdAt == resource.data.createdAt
        ) &&
        // dictCheck はゲーム途中で変更不可（dictCheck導入前の既存ルームは除く）
        (
          !('dictCheck' in resource.data) ||
          !('dictCheck' in request.resource.data) ||
          request.resource.data.dictCheck == resource.data.dictCheck
        );

      // 削除は禁止（ゲーム履歴保護。古いルームは TTL ポリシーで自動削除）
      allow delete: if false;
    }
  }
}
